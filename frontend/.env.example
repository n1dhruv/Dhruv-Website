# Last.fm Integration (Client-side)
# Note: These variables are intentionally prefixed with NEXT_PUBLIC_ and bundled into the client
# because this portfolio uses a frontend-only Last.fm integration (direct browser-to-API requests).
# Do NOT include your Last.fm Shared Secret here.
NEXT_PUBLIC_LASTFM_USERNAME=your_lastfm_username
NEXT_PUBLIC_LASTFM_API_KEY=your_lastfm_api_key
